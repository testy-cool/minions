#!/usr/bin/env bun
// minion-memory: read and write a Pi minion's memory from outside Pi, with
// Pi's own memory code, so a Pi minion running on Claude Code
// (minion <name> --claude) keeps one memory with its Pi runs.
//
//   minion-memory <agent dir> prompt                     the memory block Pi puts in its prompt
//   minion-memory <agent dir> add <target> "<text>"      save one entry
//   minion-memory <agent dir> replace <target> "<old>" "<text>"
//   minion-memory <agent dir> remove <target> "<old>"
//
// <target> is user (about Vlad), memory (general notes) or project (this
// project only), as in Pi's memory tool. Writes go through Pi's checks: the
// secret scan, the size limits, the entry format and the file locks.
import path from "node:path";

const [dir, action, target, ...rest] = process.argv.slice(2);
const usage = () => {
  console.error('usage: minion-memory <agent dir> prompt | add <target> "<text>" | replace <target> "<old>" "<text>" | remove <target> "<old>"');
  process.exit(2);
};
if (!dir || !action) usage();

// Pi's memory code finds its settings and project folders under
// PI_CODING_AGENT_DIR, which it reads when it is first loaded.
const agentDir = path.resolve(dir);
process.env.PI_CODING_AGENT_DIR = path.join(agentDir, ".pi-home");
const hermes = process.env.MINION_HERMES
  ?? path.join(process.env.HOME!, ".pi/agent/npm/node_modules/pi-hermes-memory");
const { loadConfig } = await import(path.join(hermes, "src/config.ts"));
const { MemoryStore } = await import(path.join(hermes, "src/store/memory-store.ts"));
const { StandingInstructions } = await import(path.join(hermes, "src/store/standing-instructions.ts"));
const { detectProject } = await import(path.join(hermes, "src/project.ts"));
const { buildPromptContext } = await import(path.join(hermes, "src/prompt-context.ts"));
const { STANDING_FILE } = await import(path.join(hermes, "src/constants.ts"));

const config = loadConfig(path.join(agentDir, ".pi-home/hermes-memory-config.json"));
if (!config.memoryDir) {
  console.error(`${agentDir} has no memoryDir in .pi-home/hermes-memory-config.json`);
  process.exit(1);
}
const store = new MemoryStore({ ...config, memoryDir: config.memoryDir });
await store.loadFromDisk();
// The minion works in its own folder, so this is the project Pi binds to.
const project = detectProject(config.projectsMemoryDir, agentDir);
const projectStore = project.memoryDir
  ? new MemoryStore({ ...config, memoryCharLimit: config.projectCharLimit, memoryDir: project.memoryDir })
  : null;
await projectStore?.loadFromDisk();

if (action === "prompt") {
  const standing = config.standingInstructionsEnabled !== false
    ? new StandingInstructions(path.join(config.memoryDir, STANDING_FILE))
    : null;
  await standing?.load();
  // Policy-only minions keep their entries out of the prompt; Claude has no
  // memory search, so it always gets them.
  console.log(await buildPromptContext({ ...config, memoryMode: "legacy-inject" }, store, projectStore, project.name ?? "", standing));
  process.exit(0);
}

if (!["user", "memory", "project"].includes(target)) usage();
const into = target === "project" ? projectStore : store;
if (!into) {
  console.error("this minion has no project memory");
  process.exit(1);
}
const scope = target === "project" ? "memory" : target;
let result;
if (action === "add" && rest.length === 1) result = await into.add(scope, rest[0]);
else if (action === "replace" && rest.length === 2) result = await into.replace(scope, rest[0], rest[1]);
else if (action === "remove" && rest.length === 1) result = await into.remove(scope, rest[0]);
else usage();
console.log(result.success ? `${result.message ?? "Done."} ${result.usage ?? ""}`.trim() : `Not saved: ${result.error}`);
process.exit(result.success ? 0 : 1);
